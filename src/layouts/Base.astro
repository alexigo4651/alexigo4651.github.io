---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Мои проекты: Arduino, электроника, код.' } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">8.</span>
        <span>Мои проекты</span>
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Сделано на Astro · исходники на GitHub</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f5f2;
    --surface: #ffffff;
    --surface-2: #efede8;
    --fg: #1c1b19;
    --muted: #66625a;
    --border: #dcd8cf;
    --accent: #d9381e;
    --accent-soft: #fbe4de;
    --code-bg: #faf9f7;
    --radius: 10px;
    --mono: ui-monospace, 'Cascadia Code', 'JetBrains Mono', Consolas, monospace;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #121211;
      --surface: #1b1a19;
      --surface-2: #242321;
      --fg: #ecebe8;
      --muted: #a29e96;
      --border: #34322f;
      --accent: #ff5a3c;
      --accent-soft: #3a1d17;
      --code-bg: #171615;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #121211;
    --surface: #1b1a19;
    --surface-2: #242321;
    --fg: #ecebe8;
    --muted: #a29e96;
    --border: #34322f;
    --accent: #ff5a3c;
    --accent-soft: #3a1d17;
    --code-bg: #171615;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.6 var(--sans);
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px 64px;
  }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.2; }
  h2 { margin-top: 2.5em; }
  code, pre, kbd { font-family: var(--mono); }
  :not(pre) > code {
    background: var(--surface-2);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.92em;
  }

  .site-header {
    max-width: 960px;
    margin: 0 auto;
    padding: 20px 16px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
  }
  .brand-mark {
    font-family: var(--mono);
    color: var(--accent);
    background: #111;
    border-radius: 6px;
    padding: 0 8px;
    font-weight: 700;
  }
  .site-footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 24px 16px 40px;
    color: var(--muted);
    font-size: 14px;
    border-top: 1px solid var(--border);
  }

  .tags { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; list-style: none; }
  .tags li {
    font-size: 13px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--fg);
  }

  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 15px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); white-space: nowrap; }
  th { color: var(--muted); font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.03em; }
</style>
